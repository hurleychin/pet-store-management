<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.petshop.module.customer.MemberGroupMapper">

    <resultMap id="groupMap" type="com.petshop.module.customer.MemberGroup">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="discountRate" column="discount_rate"/>
    </resultMap>

    <select id="findById" resultMap="groupMap">
        SELECT * FROM member_group WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="groupMap">
        SELECT * FROM member_group ORDER BY id
    </select>
</mapper>
